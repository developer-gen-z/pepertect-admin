# ─── Database (Supabase PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Admin Panel Auth (REQUIRED in production) ─────────────────────
# Login credentials for the admin dashboard.
# Generate a strong password; there is NO default in production.
ADMIN_EMAIL=admin@pepertect.com
ADMIN_PASSWORD=your-strong-password-here

# JWT signing secret — REQUIRED in production.
# Generate with:  openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# How long admin sessions last (e.g. 7d, 12h). Default: 7d
JWT_EXPIRES_IN=7d

# ─── Upstox Integration ────────────────────────────────────────────
# OAuth app credentials (server-side only)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://pepertect.vercel.app/callback

# Current access token pushed to the worker by /api/admin/worker-reconnect
UPSTOX_ACCESS_TOKEN=

# The Upstox account that owns the realtime token (user id in DB)
UPSTOX_ADMIN_USER_ID=

# Cloudflare Worker that proxies the Upstox WebSocket feed
NEXT_PUBLIC_UPSTOX_WORKER_URL=https://upstox-realtime.hzero9393.workers.dev

# ─── App info (optional) ───────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Pepertect
NEXT_PUBLIC_APP_URL=https://pepertect.vercel.app
